{
  "version": "v2",
  "title": "Final Protocol \u2014 Monochrome Pixel / Smooth Review",
  "size": [
    1280,
    720
  ],
  "customFonts": [
    {
      "family": "JetBrains Mono",
      "src": "https://fonts.googleapis.com/css2?family=JetBrains+Mono"
    },
    {
      "family": "Liter",
      "src": "https://statics.kimi.ai/neo-design-static/p-font/Liter.ttf"
    },
    {
      "family": "Jersey15",
      "src": "https://statics.kimi.ai/neo-design-static/p-font/Jersey15.ttf"
    }
  ],
  "theme": {
    "colors": {
      "bg": "#060606",
      "panel": "#111111",
      "cell": "#0C0C0C",
      "wall": "#242424",
      "grid": "#343434",
      "line": "#414141",
      "text": "#EEEEEE",
      "muted": "#888888",
      "white": "#F5F5F5",
      "enemy": "#D8D8D8",
      "glass": "#171717E8",
      "glassEdge": "#FFFFFF24",
      "glassHighlight": "#FFFFFF32",
      "selected": "#292929F2"
    },
    "textStyles": {
      "body": {
        "fontSize": 14,
        "fontFamily": "JetBrains Mono",
        "color": "$text"
      },
      "caption": {
        "fontSize": 10,
        "fontFamily": "JetBrains Mono",
        "color": "$muted"
      }
    }
  },
  "pages": [
    "pages/1_battle.page",
    "pages/2_components.page",
    "pages/3_reward.page"
  ]
}